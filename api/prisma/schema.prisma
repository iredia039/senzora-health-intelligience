// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  hashPassword  String
  pets          Pet[]
  conversations Conversation[]
  createdAt     DateTime        @default(now())
  phone         String?

  // Email verification. The database default is true so accounts that already exist
  // stay verified. register() sets it to false explicitly for every new signup.
  emailVerified       Boolean   @default(true)
  verifyCodeHash      String?
  verifyCodeExpiresAt DateTime?
  verifyAttempts      Int       @default(0)
  verifyCodeSentAt    DateTime?

    // Password change confirmation. The new password is stored hashed until the code is confirmed.
  pendingHashPassword      String?
  passwordCodeHash         String?
  passwordCodeExpiresAt    DateTime?
  passwordCodeAttempts     Int       @default(0)
  passwordCodeSentAt       DateTime?
}

model Conversation {
  id        Int        @id @default(autoincrement())
  userId    Int
  title     String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime   @default(now())
}

model Message {
  id             Int           @id @default(autoincrement())
  role           String
  content        String
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   String
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Pharmacy {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  address      String
  stock        Stock[]
  createdAt    DateTime @default(now())
}

model Drug {
  id                   Int      @id @default(autoincrement())
  name                 String
  description          String
  prescriptionRequired Boolean
  stock                Stock[]
  createdAt            DateTime @default(now())
}

model Stock {
  id         Int      @id @default(autoincrement())
  pharmacyId Int
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  drugId     Int
  drug       Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  quantity   Int
  price      Int
  updatedAt  DateTime @updatedAt

  @@unique([pharmacyId, drugId])
}

